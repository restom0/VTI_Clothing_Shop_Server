# Copy this file to .env and fill the secret values before running Docker Compose.

SPRING_PROFILES_ACTIVE=int

POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=

# Base64-encoded HMAC key, at least 256 bits after decoding.
# Example generator:
# powershell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET_KEY=
JWT_EXPIRATION_TIME=360000000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
STRIPE_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=

OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:5173/oauth2/success
OAUTH2_FAILURE_REDIRECT_URL=http://localhost:5173/oauth2/failure
PAYMENT_RETURN_URL=http://localhost:8080/order/success
PAYMENT_CANCEL_URL=http://localhost:8080/order/cancel
